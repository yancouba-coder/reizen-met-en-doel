import React, { useState, useEffect } from 'react';
import { Link, NavLink } from 'react-router-dom';
import { useTranslation } from 'react-i18next';
import { clsx } from 'clsx';
import { useAuth } from '../../context/AuthContext';
import Icon from '../atoms/Icon';
import Button from '../atoms/Button';
import LanguageSwitcher from '../molecules/LanguageSwitcher';

/**
 * Composant Header - En-tête principal de l'application
 * 
 * En-tête responsive avec:
 * - Logo et navigation principale
 * - Effet de scroll (changement de style après 20px)
 * - Authentification (menu utilisateur ou login/register)
 * - Sélecteur de langue
 * - Menu mobile hamburger
 * - Highlight automatique des routes actives et enfants
 * 
 * Utilise le Context d'authentification pour afficher le menu approprié.
 * 
 * @component
 * @example
 * <Header />
 * 
 * @returns {JSX.Element} En-tête avec navigation responsive
 */
const Header = () => {
    const { t } = useTranslation();
    const { user, logout, isAuthenticated } = useAuth();
    const [isMenuOpen, setIsMenuOpen] = useState(false);
    const [isUserMenuOpen, setIsUserMenuOpen] = useState(false);
    const [scrolled, setScrolled] = useState(false);

    useEffect(() => {
        const handleScroll = () => {
            setScrolled(window.scrollY > 20);
        };
        window.addEventListener('scroll', handleScroll);
        return () => window.removeEventListener('scroll', handleScroll);
    }, []);

    const navItems = [
        { to: '/', label: t('nav_home') },
        { to: '/about', label: t('nav_who_we_are') },
        { to: '/projects', label: t('nav_projects') },
        { to: '/sponsorships/waiting', label: t('nav_become_sponsor') },
        { to: '/contact', label: t('nav_contact') },
    ];

    return (
        <header
            className={clsx(
                "fixed top-0 left-0 right-0 z-50 transition-all duration-300",
                scrolled ? "bg-secondary/95 backdrop-blur-sm shadow-sm py-2" : "bg-secondary py-4"
            )}
        >
            <div className="container mx-auto px-4 flex items-center justify-between">
                {/* Logo */}
                <Link to="/" className="flex items-center gap-2 group">
                    <div className="text-text group-hover:text-primary transition-colors">
                        <Icon name="HeartHandshake" size={32} />
                    </div>
                    <div className="flex flex-col leading-none">
                        <span className="font-bold text-xl text-text">Reizen</span>
                        <span className="font-bold text-xl text-text">met een doel</span>
                    </div>
                </Link>

                {/* Desktop Nav */}
                <nav className="hidden xl:flex items-center gap-8">
                    {navItems.map((item) => (
                        <NavLink
                            key={item.to}
                            to={item.to}
                            className={({ isActive }) => {
                                // Check if current location starts with the nav item path
                                // This ensures child routes highlight their parent nav item
                                const isChildRoute = window.location.pathname.startsWith(item.to) && item.to !== '/';
                                const shouldHighlight = isActive || isChildRoute;

                                return clsx(
                                    'text-sm font-medium transition-colors hover:text-primary',
                                    shouldHighlight ? 'text-primary' : 'text-text'
                                );
                            }}
                        >
                            {item.label}
                        </NavLink>
                    ))}
                    <div className="h-6 w-px bg-text/10"></div>
                    <LanguageSwitcher />

                    {isAuthenticated ? (
                        <div className="relative">
                            <button
                                onClick={() => setIsUserMenuOpen(!isUserMenuOpen)}
                                className="flex items-center gap-2 pl-2 pr-1 py-1 rounded-full hover:bg-white/50 transition-colors"
                            >
                                <div className="w-8 h-8 rounded-full bg-primary text-text-inverse flex items-center justify-center font-bold text-sm">
                                    {user?.firstName?.charAt(0) || 'U'}
                                </div>
                                <Icon name="ChevronDown" size={16} className="text-text/60" />
                            </button>

                            {isUserMenuOpen && (
                                <div className="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-100 py-2 z-50 animate-in fade-in slide-in-from-top-2 duration-200">
                                    <div className="px-4 py-2 border-b border-gray-100 mb-2">
                                        <p className="text-sm font-bold text-text">{user?.firstName} {user?.lastName}</p>
                                        <p className="text-xs text-gray-500 truncate">{user?.email}</p>
                                    </div>
                                    <Link
                                        to="/dashboard"
                                        className="flex items-center gap-2 px-4 py-2 text-sm text-text hover:bg-secondary hover:text-primary transition-colors"
                                        onClick={() => setIsUserMenuOpen(false)}
                                    >
                                        <Icon name="LayoutDashboard" size={16} />
                                        {t('nav_dashboard') || 'Dashboard'}
                                    </Link>
                                    <Link
                                        to="/dashboard/profile"
                                        className="flex items-center gap-2 px-4 py-2 text-sm text-text hover:bg-secondary hover:text-primary transition-colors"
                                        onClick={() => setIsUserMenuOpen(false)}
                                    >
                                        <Icon name="User" size={16} />
                                        {t('nav_profile') || 'Profile'}
                                    </Link>
                                    <button
                                        onClick={() => {
                                            logout();
                                            setIsUserMenuOpen(false);
                                        }}
                                        className="w-full flex items-center gap-2 px-4 py-2 text-sm text-red-500 hover:bg-red-50 transition-colors text-left mt-1 border-t border-gray-100 pt-2"
                                    >
                                        <Icon name="LogOut" size={16} />
                                        {t('nav_logout') || 'Logout'}
                                    </button>
                                </div>
                            )}
                        </div>
                    ) : (
                        <div className="flex items-center gap-3">
                            <Link to="/login" className="text-sm font-medium text-text hover:text-primary transition-colors">
                                {t('nav_login') || 'Log In'}
                            </Link>
                            <Link to="/register">
                                <Button variant="primary" size="sm" className="rounded-full px-5">
                                    {t('nav_register') || 'Join Us'}
                                </Button>
                            </Link>
                        </div>
                    )}

                    <Link to="/donate">
                        <Button variant="outline" size="md" className="rounded-full px-6 border-primary text-primary hover:bg-primary hover:text-text-inverse">
                            {t('donate')}
                        </Button>
                    </Link>
                </nav>

                {/* Mobile Menu Button */}
                <button
                    className="xl:hidden p-2 text-text"
                    onClick={() => setIsMenuOpen(!isMenuOpen)}
                    aria-label="Toggle menu"
                >
                    <Icon name={isMenuOpen ? 'X' : 'Menu'} size={24} />
                </button>
            </div>

            {/* Mobile Nav */}
            <div
                className={clsx(
                    "xl:hidden absolute top-full left-0 right-0 bg-secondary border-t border-gray-100 shadow-lg transition-all duration-300 overflow-hidden",
                    isMenuOpen ? "max-h-screen opacity-100" : "max-h-0 opacity-0"
                )}
            >
                <div className="flex flex-col p-4 gap-4">
                    {navItems.map((item) => (
                        <NavLink
                            key={item.to}
                            to={item.to}
                            onClick={() => setIsMenuOpen(false)}
                            className={({ isActive }) => {
                                // Check if current location starts with the nav item path
                                // This ensures child routes highlight their parent nav item
                                const isChildRoute = window.location.pathname.startsWith(item.to) && item.to !== '/';
                                const shouldHighlight = isActive || isChildRoute;

                                return clsx(
                                    'text-base font-medium py-2 border-b border-gray-100',
                                    shouldHighlight ? 'text-primary' : 'text-text'
                                );
                            }}
                        >
                            {item.label}
                        </NavLink>
                    ))}
                    <div className="flex items-center justify-between py-2 border-b border-gray-100">
                        <span className="text-text font-medium">Language</span>
                        <LanguageSwitcher />
                    </div>

                    {isAuthenticated ? (
                        <>
                            <div className="py-2 border-b border-gray-100">
                                <div className="flex items-center gap-3 mb-2">
                                    <div className="w-10 h-10 rounded-full bg-primary text-text-inverse flex items-center justify-center font-bold">
                                        {user?.firstName?.charAt(0) || 'U'}
                                    </div>
                                    <div>
                                        <p className="font-bold text-text">{user?.firstName} {user?.lastName}</p>
                                        <p className="text-xs text-gray-500">{user?.email}</p>
                                    </div>
                                </div>
                                <Link
                                    to="/dashboard"
                                    className="flex items-center gap-2 py-2 text-text"
                                    onClick={() => setIsMenuOpen(false)}
                                >
                                    <Icon name="LayoutDashboard" size={18} />
                                    {t('nav_dashboard') || 'Dashboard'}
                                </Link>
                                <button
                                    onClick={() => {
                                        logout();
                                        setIsMenuOpen(false);
                                    }}
                                    className="flex items-center gap-2 py-2 text-red-500 w-full text-left"
                                >
                                    <Icon name="LogOut" size={18} />
                                    {t('nav_logout') || 'Logout'}
                                </button>
                            </div>
                        </>
                    ) : (
                        <div className="grid grid-cols-2 gap-3 mt-4">
                            <Link to="/login" onClick={() => setIsMenuOpen(false)}>
                                <Button variant="outline" className="w-full justify-center">
                                    {t('nav_login') || 'Log In'}
                                </Button>
                            </Link>
                            <Link to="/register" onClick={() => setIsMenuOpen(false)}>
                                <Button variant="primary" className="w-full justify-center">
                                    {t('nav_register') || 'Sign Up'}
                                </Button>
                            </Link>
                        </div>
                    )}

                    <Link to="/donate" onClick={() => setIsMenuOpen(false)}>
                        <Button variant="primary" size="md" className="w-full rounded-full mt-4 bg-gradient-to-r from-primary to-accent border-none">
                            {t('donate')}
                        </Button>
                    </Link>
                </div>
            </div>
        </header>
            <div className="container mx-auto px-4 flex items-center justify-between">
                {/* Logo */}
                <Link to="/" className="flex items-center gap-2 group">
                    <div className="text-brand-dark group-hover:text-brand-orange transition-colors">
                        <Icon name="HeartHandshake" size={32} />
                    </div>
                    <div className="flex flex-col leading-none">
                        <span className="font-bold text-xl text-brand-dark">Reizen</span>
                        <span className="font-bold text-xl text-brand-dark">met een doel</span>
                    </div>
                </Link>

                {/* Desktop Nav */}
                <nav className="hidden xl:flex items-center gap-8">
                    {navItems.map((item) => (
                        <NavLink
                            key={item.to}
                            to={item.to}
                            className={({ isActive }) => {
                                // Check if current location starts with the nav item path
                                // This ensures child routes highlight their parent nav item
                                const isChildRoute = window.location.pathname.startsWith(item.to) && item.to !== '/';
                                const shouldHighlight = isActive || isChildRoute;

                                return clsx(
                                    'text-sm font-medium transition-colors hover:text-brand-orange',
                                    shouldHighlight ? 'text-brand-orange' : 'text-brand-dark'
                                );
                            }}
                        >
                            {item.label}
                        </NavLink>
                    ))}
                    <div className="h-6 w-px bg-brand-dark/10"></div>
                    <LanguageSwitcher />

                    {isAuthenticated ? (
                        <div className="relative">
                            <button
                                onClick={() => setIsUserMenuOpen(!isUserMenuOpen)}
                                className="flex items-center gap-2 pl-2 pr-1 py-1 rounded-full hover:bg-white/50 transition-colors"
                            >
                                <div className="w-8 h-8 rounded-full bg-brand-orange text-white flex items-center justify-center font-bold text-sm">
                                    {user?.firstName?.charAt(0) || 'U'}
                                </div>
                                <Icon name="ChevronDown" size={16} className="text-brand-dark/60" />
                            </button>

                            {isUserMenuOpen && (
                                <div className="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-100 py-2 z-50 animate-in fade-in slide-in-from-top-2 duration-200">
                                    <div className="px-4 py-2 border-b border-gray-100 mb-2">
                                        <p className="text-sm font-bold text-brand-dark">{user?.firstName} {user?.lastName}</p>
                                        <p className="text-xs text-gray-500 truncate">{user?.email}</p>
                                    </div>
                                    <Link
                                        to="/dashboard"
                                        className="flex items-center gap-2 px-4 py-2 text-sm text-brand-dark hover:bg-brand-beige hover:text-brand-orange transition-colors"
                                        onClick={() => setIsUserMenuOpen(false)}
                                    >
                                        <Icon name="LayoutDashboard" size={16} />
                                        {t('nav_dashboard') || 'Dashboard'}
                                    </Link>
                                    <Link
                                        to="/dashboard/profile"
                                        className="flex items-center gap-2 px-4 py-2 text-sm text-brand-dark hover:bg-brand-beige hover:text-brand-orange transition-colors"
                                        onClick={() => setIsUserMenuOpen(false)}
                                    >
                                        <Icon name="User" size={16} />
                                        {t('nav_profile') || 'Profile'}
                                    </Link>
                                    <button
                                        onClick={() => {
                                            logout();
                                            setIsUserMenuOpen(false);
                                        }}
                                        className="w-full flex items-center gap-2 px-4 py-2 text-sm text-red-500 hover:bg-red-50 transition-colors text-left mt-1 border-t border-gray-100 pt-2"
                                    >
                                        <Icon name="LogOut" size={16} />
                                        {t('nav_logout') || 'Logout'}
                                    </button>
                                </div>
                            )}
                        </div>
                    ) : (
                        <div className="flex items-center gap-3">
                            <Link to="/login" className="text-sm font-medium text-brand-dark hover:text-brand-orange transition-colors">
                                {t('nav_login') || 'Log In'}
                            </Link>
                            <Link to="/register">
                                <Button variant="primary" size="sm" className="rounded-full px-5">
                                    {t('nav_register') || 'Join Us'}
                                </Button>
                            </Link>
                        </div>
                    )}

                    <Link to="/donate">
                        <Button variant="outline" size="md" className="rounded-full px-6 border-brand-orange text-brand-orange hover:bg-brand-orange hover:text-white">
                            {t('donate')}
                        </Button>
                    </Link>
                </nav>

                {/* Mobile Menu Button */}
                <button
                    className="xl:hidden p-2 text-brand-dark"
                    onClick={() => setIsMenuOpen(!isMenuOpen)}
                    aria-label="Toggle menu"
                >
                    <Icon name={isMenuOpen ? 'X' : 'Menu'} size={24} />
                </button>
            </div>

            {/* Mobile Nav */ }
    <div
        className={clsx(
            "xl:hidden absolute top-full left-0 right-0 bg-brand-beige border-t border-gray-100 shadow-lg transition-all duration-300 overflow-hidden",
            isMenuOpen ? "max-h-screen opacity-100" : "max-h-0 opacity-0"
        )}
    >
        <div className="flex flex-col p-4 gap-4">
            {navItems.map((item) => (
                <NavLink
                    key={item.to}
                    to={item.to}
                    onClick={() => setIsMenuOpen(false)}
                    className={({ isActive }) => {
                        // Check if current location starts with the nav item path
                        // This ensures child routes highlight their parent nav item
                        const isChildRoute = window.location.pathname.startsWith(item.to) && item.to !== '/';
                        const shouldHighlight = isActive || isChildRoute;

                        return clsx(
                            'text-base font-medium py-2 border-b border-gray-100',
                            shouldHighlight ? 'text-brand-orange' : 'text-brand-dark'
                        );
                    }}
                >
                    {item.label}
                </NavLink>
            ))}
            <div className="flex items-center justify-between py-2 border-b border-gray-100">
                <span className="text-brand-dark font-medium">Language</span>
                <LanguageSwitcher />
            </div>

            {isAuthenticated ? (
                <>
                    <div className="py-2 border-b border-gray-100">
                        <div className="flex items-center gap-3 mb-2">
                            <div className="w-10 h-10 rounded-full bg-brand-orange text-white flex items-center justify-center font-bold">
                                {user?.firstName?.charAt(0) || 'U'}
                            </div>
                            <div>
                                <p className="font-bold text-brand-dark">{user?.firstName} {user?.lastName}</p>
                                <p className="text-xs text-gray-500">{user?.email}</p>
                            </div>
                        </div>
                        <Link
                            to="/dashboard"
                            className="flex items-center gap-2 py-2 text-brand-dark"
                            onClick={() => setIsMenuOpen(false)}
                        >
                            <Icon name="LayoutDashboard" size={18} />
                            {t('nav_dashboard') || 'Dashboard'}
                        </Link>
                        <button
                            onClick={() => {
                                logout();
                                setIsMenuOpen(false);
                            }}
                            className="flex items-center gap-2 py-2 text-red-500 w-full text-left"
                        >
                            <Icon name="LogOut" size={18} />
                            {t('nav_logout') || 'Logout'}
                        </button>
                    </div>
                </>
            ) : (
                <div className="grid grid-cols-2 gap-3 mt-4">
                    <Link to="/login" onClick={() => setIsMenuOpen(false)}>
                        <Button variant="outline" className="w-full justify-center">
                            {t('nav_login') || 'Log In'}
                        </Button>
                    </Link>
                    <Link to="/register" onClick={() => setIsMenuOpen(false)}>
                        <Button variant="primary" className="w-full justify-center">
                            {t('nav_register') || 'Sign Up'}
                        </Button>
                    </Link>
                </div>
            )}

            <Link to="/donate" onClick={() => setIsMenuOpen(false)}>
                <Button variant="primary" size="md" className="w-full rounded-full mt-4 bg-gradient-to-r from-brand-orange to-brand-terracotta border-none">
                    {t('donate')}
                </Button>
            </Link>
        </div>
    </div>
        </header >
    );
};

export default Header;
